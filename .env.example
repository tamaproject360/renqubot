# Runtime mode
NODE_ENV=development

# Legacy bot runtime database
DATABASE_URL=file:./data/baileys.db

# Backend API service
API_PORT=3001

# Admin frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Gemini AI provider for legacy bot runtime
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_HOST=

# Google Spreadsheet integration
SPREADSHEET_ID=
GCLOUD_KEY_PATH=./data/credentials/google-service-account.json

# Spreadsheet file/context name used by legacy config logs and admin config semantics
SPREADSHEET_NAME=infos

# Sheet tab name used by the spreadsheet append runtime
SHEET_NAME=Logs

# WhatsApp access control, comma-separated phone numbers without plus sign
# Example: ALLOWED_USER_IDS=628931232132,62894324322,62891234234
ALLOWED_USER_IDS=

# Admin configuration storage paths
CONFIG_PATH=./data/config/app-config.json
SECRETS_PATH=./data/config/app-secrets.json
SECRETS_META_PATH=./data/config/app-secrets-meta.json
AUDIT_LOG_PATH=./data/config/audit-log.jsonl
CREDENTIALS_DIR=./data/credentials

# Runtime bridge shared by bot runtime and backend API
WHATSAPP_RUNTIME_STATE_PATH=./data/runtime/whatsapp-status.json
