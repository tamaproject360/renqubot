# Runtime mode
NODE_ENV=production

# Public URL used by browser-side Next.js code.
# For a server test with exposed port, use: http://YOUR_SERVER_IP:3001
# If using a domain/reverse proxy, use your public API URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Backend API
API_PORT=3001
API_CORS_ORIGIN=*

# Database and persisted runtime paths inside Docker
DATABASE_URL=sqlite:///app/data/baileys.db
CONFIG_PATH=/app/data/config/app-config.json
SECRETS_PATH=/app/data/config/app-secrets.json
SECRETS_META_PATH=/app/data/config/app-secrets-meta.json
AUDIT_LOG_PATH=/app/data/config/audit-log.jsonl
CREDENTIALS_DIR=/app/data/credentials
WHATSAPP_RUNTIME_STATE_PATH=/app/data/runtime/whatsapp-status.json

# AI provider: gemini, openai, anthropic, openai-compatible
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_HOST=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com
CUSTOM_PROVIDER_NAME=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_BASE_URL=

# Google Spreadsheet integration
SPREADSHEET_ID=
SPREADSHEET_NAME=keuangan
SHEET_NAME=catatan
GCLOUD_KEY_PATH=/app/data/credentials/google-service-account.json

# WhatsApp access control, comma-separated phone numbers without plus sign.
# Example: ALLOWED_USER_IDS=628931232132,62894324322
ALLOWED_USER_IDS=
