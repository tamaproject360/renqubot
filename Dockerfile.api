FROM oven/bun:1.3.3-slim AS deps
WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY services/api/package.json ./services/api/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN bun install --frozen-lockfile

FROM oven/bun:1.3.3-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV API_PORT=3001

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/services/api/node_modules ./services/api/node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/bun.lock ./bun.lock
COPY --from=deps /app/tsconfig.json ./tsconfig.json
COPY services ./services
COPY src ./src

RUN mkdir -p /app/data/config /app/data/credentials /app/data/runtime

EXPOSE 3001
CMD ["bun", "run", "start:backend"]
